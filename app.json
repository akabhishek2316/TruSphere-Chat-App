{
  "expo": {
    "name": "TruSphere",
    "slug": "trusphere",
     "scheme": "trusphere",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    }, 
    "ios": {
      "bundleIdentifier": "com.trusphere.chat",
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon-foreground.png",
        "backgroundColor": "#07111F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trusphere.chat",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TruSphere needs access to your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TruSphere needs microphone access to send voice messages."
        }
      ],
      
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/app-icon.png",
          "color": "#2563EB",
          "defaultChannel": "messages"
        }
      ],
      "expo-font",
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-share-intent"
    ],
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1dacabdf-1357-452e-827a-d871deda7282"
      }
    },
    "owner": "abhi_app_development"
  }
}
